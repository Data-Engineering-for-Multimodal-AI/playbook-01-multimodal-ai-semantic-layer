{
  "name": "Playbook 01: semantic layer",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "onCreateCommand": "pip install --no-cache-dir uv==0.13.0",
  "postCreateCommand": "make setup",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "API and reviewer UI" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
